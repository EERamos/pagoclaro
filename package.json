{
  "name": "pagoclaro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Agente de cuentas por pagar: lee facturas dos veces, decide pagar, frenar o escalar con reglas deterministas y explica cada decisión (reto Blinka, Hackathon 30X)",
  "license": "MIT",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "evals": "tsx runner/run-evals.ts",
    "blind": "tsx runner/run-blind.ts",
    "probe": "tsx scripts/probe-model.ts",
    "seed": "tsx scripts/seed-demo.ts",
    "demo:static": "tsx scripts/build-static-demo.ts",
    "render:samples": "tsx scripts/render-samples.ts",
    "video:prep": "tsx scripts/seed-demo.ts --readers=replay --out=data/video --no-approvals && tsx scripts/video-prep.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@resvg/resvg-js": "2.6.2",
    "fastify": "5.12.7",
    "pdf-lib": "1.17.1",
    "postal-mime": "4.0.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
