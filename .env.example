# Copia este archivo a .env (nunca se sube a git).

# Clave de la API de Anthropic. Sin ella el tablero corre con lecturas guardadas (modo replay).
ANTHROPIC_API_KEY=

# Código que pide el tablero y la API para escribir (subir, aprobar, rechazar, cambiar reglas).
PAGOCLARO_ACCESS_CODE=

# Lectores: record (lee en vivo y guarda), live (solo en vivo), replay (solo guardadas), ollama (local, solo texto).
EXTRACTOR_MODE=
PRIMARY_MODEL=claude-opus-5-5
CHECK_MODEL=claude-haiku-5-5

# Tope de gasto en modelos, en USD. Ninguna llamada arranca al llegarlo.
MODEL_SPEND_CAP_USD=50

PORT=3000
HOST=localhost
PAGOCLARO_DATA_DIR=data
PAGOCLARO_WORLD=fixtures/world/northwind.json
READINGS_DIR=fixtures/readings
